# Copy this file to ".env" in the project folder and edit it. Every variable is optional.
# Variables that are already set in your shell take precedence over this file.
# Never commit your real .env (it is git-ignored).

# --- Server (only used by `python app.py`) ---
# HR_AGENT_HOST=127.0.0.1
# HR_AGENT_PORT=5000
# HR_AGENT_DEBUG=1

# --- Data ---
# Folder for the SQLite database and uploaded files (default: ./data)
# HR_AGENT_DATA_DIR=

# --- First run / sessions ---
# Password for the first admin user "admin", used only when the database has no users yet.
# If unset, a random password is generated and printed once in the console.
# HR_AGENT_ADMIN_PASSWORD=
# Secret used to sign login sessions. If unset, a random one is generated and saved in data/secret_key.
# HR_AGENT_SECRET_KEY=

# --- Display name used in emails, offer letters, report footers and AI prompts ---
# COMPANY_NAME=Your Company
# COMPANY_WEBSITE=www.example.com

# --- Optional integrations ---
# Folder with the editable email .docx templates (default: ./email_templates)
# HR_AGENT_EMAIL_TEMPLATE_DIR=
# Folder of an external Markdown-to-Word report template renderer (not included; leave empty to
# use the built-in PDF reports)
# REPORT_TEMPLATE_DIR=

# The AI scoring API key and the email (SMTP) account are NOT environment variables: each is
# entered in the web UI under Settings and stored in the local database.
